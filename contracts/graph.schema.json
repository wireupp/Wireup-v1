{
  "$defs": {
    "ArtifactRef": {
      "additionalProperties": false,
      "properties": {
        "bytes": {
          "minimum": 0,
          "type": "integer"
        },
        "created_at": {
          "format": "date-time",
          "type": "string"
        },
        "filename": {
          "type": "string"
        },
        "id": {
          "type": "string"
        },
        "kind": {
          "type": "string"
        },
        "media_type": {
          "type": "string"
        },
        "produced_by": {
          "type": "string"
        },
        "project_revision": {
          "minimum": 0,
          "type": "integer"
        },
        "sha256": {
          "pattern": "^[a-f0-9]{64}$",
          "type": "string"
        },
        "source_revision": {
          "minimum": 0,
          "type": "integer"
        }
      },
      "required": [
        "id",
        "kind",
        "filename",
        "sha256",
        "produced_by"
      ],
      "type": "object"
    },
    "Edge": {
      "additionalProperties": false,
      "properties": {
        "from": {
          "additionalProperties": false,
          "properties": {
            "node": {
              "maxLength": 128,
              "minLength": 1,
              "type": "string"
            },
            "port": {
              "maxLength": 64,
              "minLength": 1,
              "type": "string"
            }
          },
          "required": [
            "node",
            "port"
          ],
          "type": "object"
        },
        "id": {
          "maxLength": 128,
          "minLength": 1,
          "type": "string"
        },
        "kind": {
          "description": "Port type carried. Must be compatible with both endpoints.",
          "type": "string"
        },
        "properties": {
          "type": "object"
        },
        "to": {
          "additionalProperties": false,
          "properties": {
            "node": {
              "maxLength": 128,
              "minLength": 1,
              "type": "string"
            },
            "port": {
              "maxLength": 64,
              "minLength": 1,
              "type": "string"
            }
          },
          "required": [
            "node",
            "port"
          ],
          "type": "object"
        },
        "value": {}
      },
      "required": [
        "id",
        "from",
        "to"
      ],
      "type": "object"
    },
    "Firmware": {
      "additionalProperties": false,
      "description": "One firmware document per project, not per node.",
      "properties": {
        "filename": {
          "minLength": 1,
          "type": "string"
        },
        "language": {
          "enum": [
            "arduino",
            "python",
            "c",
            "javascript",
            "html"
          ]
        },
        "revision": {
          "minimum": 0,
          "type": "integer"
        },
        "source": {
          "maxLength": 2000000,
          "type": "string"
        },
        "target_board": {
          "type": [
            "string",
            "null"
          ]
        }
      },
      "required": [
        "filename",
        "language",
        "source",
        "revision"
      ],
      "type": "object"
    },
    "Node": {
      "additionalProperties": false,
      "properties": {
        "id": {
          "description": "Kind prefix plus a short hash, so an id is self-describing in an error message.",
          "pattern": "^[a-z][a-z0-9_]*_[a-f0-9]{8}$",
          "type": "string"
        },
        "kind": {
          "description": "group.kind. Must exist in contracts/kinds.json.",
          "pattern": "^[a-z][a-z0-9_]*\\.[a-z][a-z0-9_]*$",
          "type": "string"
        },
        "label": {
          "maxLength": 120,
          "type": "string"
        },
        "parent_id": {
          "description": "Containment. Must not form a cycle.",
          "type": [
            "string",
            "null"
          ]
        },
        "position": {
          "additionalProperties": false,
          "properties": {
            "x": {
              "type": "number"
            },
            "y": {
              "type": "number"
            },
            "z": {
              "type": "number"
            }
          },
          "type": "object"
        },
        "properties": {
          "type": "object"
        },
        "rotation": {
          "type": "number"
        }
      },
      "required": [
        "id",
        "kind"
      ],
      "type": "object"
    },
    "Port": {
      "additionalProperties": false,
      "properties": {
        "direction": {
          "enum": [
            "in",
            "out",
            "inout"
          ]
        },
        "name": {
          "maxLength": 64,
          "minLength": 1,
          "type": "string"
        },
        "required": {
          "default": false,
          "type": "boolean"
        },
        "type": {
          "description": "Must exist in contracts/port-types.json. An unknown type is an error naming the port, never coerced.",
          "type": "string"
        },
        "unit": {
          "type": [
            "string",
            "null"
          ]
        }
      },
      "required": [
        "name",
        "type",
        "direction"
      ],
      "type": "object"
    }
  },
  "$id": "https://wireup.dev/contracts/graph.schema.json",
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "additionalProperties": false,
  "description": "The universal project model. A circuit, a boat, a drone and a website are all graphs of typed nodes. Adding a domain means adding node kinds and a solver, never forking this shape.",
  "properties": {
    "artifacts": {
      "items": {
        "$ref": "#/$defs/ArtifactRef"
      },
      "type": "array"
    },
    "created_at": {
      "format": "date-time",
      "type": "string"
    },
    "domain": {
      "enum": [
        "electronics",
        "mechanics",
        "software",
        "environment",
        "hybrid"
      ]
    },
    "edges": {
      "items": {
        "$ref": "#/$defs/Edge"
      },
      "type": "array"
    },
    "firmware": {
      "$ref": "#/$defs/Firmware"
    },
    "id": {
      "pattern": "^[a-f0-9]{32}$",
      "type": "string"
    },
    "metadata": {
      "type": "object"
    },
    "name": {
      "maxLength": 120,
      "minLength": 1,
      "type": "string"
    },
    "nodes": {
      "items": {
        "$ref": "#/$defs/Node"
      },
      "type": "array"
    },
    "parent_project_id": {
      "pattern": "^[a-f0-9]{32}$",
      "type": [
        "string",
        "null"
      ]
    },
    "revision": {
      "description": "Monotonic. Every mutation increments it exactly once and requires the caller's expected_revision to match.",
      "minimum": 0,
      "type": "integer"
    },
    "schema_version": {
      "const": 3,
      "description": "Incremented only by a phase that migrates every consumer. An unknown value is rejected, never assumed."
    },
    "updated_at": {
      "format": "date-time",
      "type": "string"
    }
  },
  "required": [
    "schema_version",
    "id",
    "domain",
    "revision",
    "nodes",
    "edges",
    "created_at",
    "updated_at"
  ],
  "title": "WireUp project graph",
  "type": "object"
}
