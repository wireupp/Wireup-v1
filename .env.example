GROQ_API_KEY=
GROQ_MODEL=openai/gpt-oss-120b
BACKEND_PORT=8000

# NVIDIA hosted model (server-only)
NVIDIA_API_KEY=
NVIDIA_MODEL=z-ai/glm-5.3

BEDROCK_MODEL_ID=moonshotai.kimi-k2.5
BEDROCK_API_KEY=

# ZenLLM — OpenAI-compatible gateway (Claude, GPT, Gemini, DeepSeek, Qwen)
# Available models: claude-sonnet-5, claude-opus-5.5, claude-haiku-5.5,
#   deepseek-v4-pro, deepseek-v4-flash, deepseek-r1,
#   gpt-4.2, gpt-4.2-mini, gemini-2.5-pro, gemini-2.5-flash, qwen-3-8-max
ZENLLM_API_KEY=
ZENLLM_MODEL=claude-sonnet-5

# Azure OpenAI-compatible model
AZURE_API_KEY=
AZURE_MODEL_ID=gpt-6.1-sol
AZURE_BASE_URL=https://project-t3-resource.services.ai.azure.com/openai/v1

# Hosted preview access (set these in Vercel; never commit the real token)
WIREUP_DEPLOYMENT=preview
WIREUP_ACCESS_TOKEN=
WIREUP_ALLOWED_ORIGINS=https://wireup-git-preview-aldens-projects-352935df.vercel.app
WIREUP_PUBLIC_HEALTH=true
