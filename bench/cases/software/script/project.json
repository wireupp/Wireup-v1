        "files": {
          "index.html": "<!DOCTYPE html>\n<html lang=\"en\">\n<head>\n<meta charset=\"utf-8\">\n<title>WireUp Bench</title>\n<link rel=\"stylesheet\" href=\"style.css\">\n</head>\n<body>\n<main id=\"readout\">\n<h1>WireUp bench</h1>\n<p id=\"status\">ready</p>\n<ul class=\"telemetry\">\n<li data-channel=\"hull.speed_surge_mps\">1.200 m/s</li>\n<li data-channel=\"hull.draft_m\">0.072 m</li>\n</ul>\n</main>\n</body>\n</html>\n",
          "style.css": "body { font-family: system-ui, sans-serif; }\n#status { color: rgb(0, 128, 0); }\n"
        },
        "dom_operations": [
          { "id": "title", "op": "title", "expression": "value", "expect": { "op": "eq", "value": "WireUp Bench" } },
          { "id": "status-exists", "op": "exists", "selector": "#status", "expression": "value", "expect": { "op": "eq", "value": true } },
          { "id": "status-text", "op": "text", "selector": "#status", "expression": "value", "expect": { "op": "eq", "value": "ready" } },
          { "id": "telemetry-count", "op": "count", "selector": "li", "expression": "value", "expect": { "op": "eq", "value": 2 } },
          { "id": "status-attr", "op": "attr", "selector": "#status", "attribute": "id", "expression": "value", "expect": { "op": "eq", "value": "status" } }
        ]
      }
    }
